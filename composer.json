{
    "name": "sales-snap/mautic-google-auth-bundle",
    "description": "Google sign-in plugin for Mautic users matched by email.",
    "type": "mautic-plugin",
    "license": "proprietary",
    "homepage": "https://github.com/AlexanderZlobinM1/GoogleAuthBundle",
    "keywords": [
        "mautic",
        "mautic-plugin",
        "google",
        "authentication",
        "security"
    ],
    "authors": [
        {
            "name": "Alexander Zlobin",
            "role": "Maintainer"
        }
    ],
    "support": {
        "issues": "https://github.com/AlexanderZlobinM1/GoogleAuthBundle/issues",
        "source": "https://github.com/AlexanderZlobinM1/GoogleAuthBundle"
    },
    "autoload": {
        "psr-4": {
            "MauticPlugin\\GoogleAuthBundle\\": ""
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MauticPlugin\\GoogleAuthBundle\\Tests\\": "Tests/"
        }
    },
    "extra": {
        "install-directory-name": "GoogleAuthBundle"
    },
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "ext-openssl": "*",
            "mautic/core-lib": ">=5.2 <5.3 || >=6.0 <6.1 || >=7.1 <7.3"
    }
}
